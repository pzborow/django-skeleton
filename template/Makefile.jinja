DC = docker compose

.PHONY: help env build up down logs clean test lint format be-shell be-install{% if use_frontend %} fe-shell fe-install fe-build{% endif %}

help:
	@echo "Komendy:"
	@echo "  env              .env z .env.example (jeśli jeszcze nie ma)"
	@echo "  build            budowa obrazów"
	@echo "  up               start w tle"
	@echo "  down             stop"
	@echo "  logs             logi wszystkich usług"
	@echo "  clean            stop z usunięciem wolumenów i obrazów"
	@echo ""
	@echo "Backend (kontener musi działać, make up):"
	@echo "  be-<komenda>     manage.py <komenda>, np. make be-migrate"
	@echo "  be-shell         bash w kontenerze web"
	@echo "  be-install PKG=  doinstalowanie paczki na próbę (na stałe: pyproject.toml i make build)"
	@echo "  test             pytest"
	@echo "  lint             ruff check"
	@echo "  format           ruff format i poprawki"
{%- if use_frontend %}
	@echo ""
	@echo "Frontend (kontener musi działać, make up):"
	@echo "  fe-shell         sh w kontenerze vue"
	@echo "  fe-install PKG=  nowa paczka npm (package.json), potem make build"
	@echo "  fe-build         produkcyjny build Nuxta"
{%- endif %}

env:
	test -f .env || cp .env.example .env

build: env
	$(DC) build

up: env
	$(DC) up -d

down:
	$(DC) down

logs:
	$(DC) logs -f

clean:
	$(DC) down --volumes --rmi all

test:
	$(DC) exec web pytest

lint:
	$(DC) exec web ruff check .

format:
	$(DC) exec web sh -c "ruff check --fix . && ruff format ."

be-shell:
	$(DC) exec web bash

be-install:
	$(DC) exec web uv pip install --system $(PKG)

be-%:
	$(DC) exec web python manage.py $*
{%- if use_frontend %}

fe-shell:
	$(DC) exec vue sh

fe-install:
	$(DC) exec vue npm install $(PKG)

fe-build:
	$(DC) exec vue npm run build
{%- endif %}
