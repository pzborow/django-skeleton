services:
  django:
    build:
      context: .
      dockerfile: docker/dev/django/Dockerfile
    container_name: {{ project_slug }}_django
    volumes:
      - ./backend:/app
    ports:
      - "8000:8000"
    networks:
      - app_network
    environment:
      - PYTHONDONTWRITEBYTECODE=1
      - PYTHONUNBUFFERED=1
    env_file:
      - ./docker/dev/django/.env

{%- if use_frontend %}
  # Nuxt z SSR
  vue:
    build:
      context: .
      dockerfile: docker/dev/vue/Dockerfile
    container_name: {{ project_slug }}_vue
    volumes:
      - ./frontend:/app
      - /app/node_modules  # node_modules z obrazu, nie z hosta
    environment:
      - NODE_ENV=development
    ports:
      - "3000:3000"
    networks:
      - app_network

  # wspólne wejście: /backend/ do Django, reszta do Nuxta
  nginx:
    build:
      context: .
      dockerfile: docker/dev/nginx/Dockerfile
    container_name: {{ project_slug }}_nginx
    ports:
      - "8001:80"
    networks:
      - app_network
    depends_on:
      - django
      - vue
{% endif %}
  db:
    image: postgres
    volumes:
      - db_data:/var/lib/postgresql
    environment:
      POSTGRES_DB: {{ project_slug }}
      POSTGRES_USER: {{ project_slug }}
      POSTGRES_PASSWORD: {{ project_slug }}
    networks:
      - app_network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ project_slug }} -d {{ project_slug }}"]
      interval: 10s
      timeout: 5s
      retries: 5

networks:
  app_network:
    driver: bridge

volumes:
  db_data:
    driver: local
