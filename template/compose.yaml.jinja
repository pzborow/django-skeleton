name: {{ project_slug }}

# wspólne dla aplikacji{% if use_celery %}, workera i beata{% endif %}
x-app: &app
  build:
    context: .
    dockerfile: docker/dev/django/Dockerfile
  env_file:
    - ./docker/dev/django/.env
  volumes:
    - ./backend:/app
  depends_on:
    db:
      condition: service_healthy
{%- if use_celery %}
    redis:
      condition: service_healthy
{%- endif %}

services:
  web:
    <<: *app
    command: sh -c "python manage.py migrate && python manage.py runserver 0.0.0.0:8000"
    ports:
      - "8000:8000"
{% if use_celery %}
  worker:
    <<: *app
    command: celery -A config worker -l info

  beat:
    <<: *app
    command: celery -A config beat -l info -s /tmp/celerybeat-schedule
{% endif %}
{%- if use_frontend %}
  # Nuxt z SSR
  vue:
    build:
      context: .
      dockerfile: docker/dev/vue/Dockerfile
    volumes:
      - ./frontend:/app
      - /app/node_modules  # node_modules z obrazu, nie z hosta
    environment:
      - NODE_ENV=development
    ports:
      - "3000:3000"

  # wspólne wejście: /backend/ do Django, reszta do Nuxta
  nginx:
    build:
      context: .
      dockerfile: docker/dev/nginx/Dockerfile
    ports:
      - "8001:80"
    depends_on:
      - web
      - vue
{% endif %}
  # baza{% if use_celery %} i redis{% endif %} bez portów na hoście, żeby nie gryzły się z innymi projektami
  db:
    image: postgres:16-alpine
    environment:
      POSTGRES_DB: {{ project_slug }}
      POSTGRES_USER: {{ project_slug }}
      POSTGRES_PASSWORD: {{ project_slug }}
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ project_slug }} -d {{ project_slug }}"]
      interval: 3s
      timeout: 3s
      retries: 20
{% if use_celery %}
  redis:
    image: redis:7-alpine
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 3s
      timeout: 3s
      retries: 20
{% endif %}
volumes:
  pgdata:
