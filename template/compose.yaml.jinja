name: {{ project_slug }}

# wspólne dla aplikacji{% if use_celery %}, workera i beata{% endif %} (jeden obraz, buduje go web)
x-app: &app
  image: {{ project_slug }}-django
  env_file: .env
  volumes:
    - ./backend:/app
  depends_on:
    db:
      condition: service_healthy
{%- if use_celery %}
    redis:
      condition: service_healthy
{%- endif %}
{%- if use_elasticsearch %}
    elasticsearch:
      condition: service_healthy
{%- endif %}

services:
  web:
    <<: *app
    build:
      context: .
      dockerfile: docker/dev/django/Dockerfile
      args:
        UID: ${UID:?brak UID w .env, make env}
    # entrypoint tylko tu, żeby worker i beat nie puszczały migracji równolegle
    entrypoint: ["entrypoint.sh"]
    command: python manage.py runserver 0.0.0.0:8000
    ports:
      - "127.0.0.1:${WEB_PORT:?brak WEB_PORT w .env}:8000"
{% if use_celery %}
  worker:
    <<: *app
    command: celery -A config worker -l info

  beat:
    <<: *app
    command: celery -A config beat -l info -s /tmp/celerybeat-schedule
{% endif %}
{%- if use_frontend %}
  # Nuxt z SSR
  vue:
    build:
      context: .
      dockerfile: docker/dev/vue/Dockerfile
      args:
        UID: ${UID:?brak UID w .env, make env}
    volumes:
      - ./frontend:/app
      - /app/node_modules  # node_modules z obrazu, nie z hosta
    environment:
      - NODE_ENV=development
    ports:
      - "127.0.0.1:${FRONT_PORT:?brak FRONT_PORT w .env}:3000"

  # wspólne wejście: /backend/ do Django, reszta do Nuxta
  nginx:
    build:
      context: .
      dockerfile: docker/dev/nginx/Dockerfile
    ports:
      - "127.0.0.1:${NGINX_PORT:?brak NGINX_PORT w .env}:80"
    depends_on:
      - web
      - vue
{% endif %}
  # usługi pomocnicze bez portów na hoście, żeby nie gryzły się z innymi projektami
  db:
    image: postgres:17-alpine
    # tylko dane bazy z .env, bez reszty (SECRET_KEY, hasło admina)
    environment:
      POSTGRES_DB: ${POSTGRES_DB}
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 3s
      timeout: 3s
      retries: 20
{% if use_celery %}
  redis:
    image: redis:7-alpine
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 3s
      timeout: 3s
      retries: 20
{% endif %}
{%- if use_elasticsearch %}
  elasticsearch:
    image: docker.elastic.co/elasticsearch/elasticsearch:8.15.3
    environment:
      - discovery.type=single-node
      - xpack.security.enabled=false
      - ES_JAVA_OPTS=-Xms512m -Xmx512m
      # dev: ES nie blokuje indeksów, gdy na dysku zostaje mało miejsca
      - cluster.routing.allocation.disk.threshold_enabled=false
    volumes:
      - es-data:/usr/share/elasticsearch/data
    healthcheck:
      test: ["CMD-SHELL", "curl -fs 'http://localhost:9200/_cluster/health?wait_for_status=yellow&timeout=5s' || exit 1"]
      interval: 5s
      timeout: 10s
      retries: 30
{% endif %}
volumes:
  pgdata:
{%- if use_elasticsearch %}
  es-data:
{%- endif %}
