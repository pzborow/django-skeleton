FROM python:{{ python_version }}-slim

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /usr/local/bin/uv

# ten sam UID co użytkownik na hoście, inaczej pliki pisane do montowanego backend/ (cache, uv.lock) należą do roota
ARG UID
RUN useradd --uid ${UID} --create-home app && install -d -o app -g app /opt/venv

# środowisko w /opt/venv, poza /app, bo /app przykrywa montowany z compose katalog backend
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_NO_CACHE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH

WORKDIR /app
RUN chown app:app /app
USER app

COPY --chown=app:app backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --extra dev --no-install-project

COPY --chmod=755 docker/dev/django/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --chown=app:app backend/ .

EXPOSE 8000

CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
