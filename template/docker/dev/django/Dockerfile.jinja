FROM python:{{ python_version }}-slim

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /usr/local/bin/uv

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_NO_CACHE=1

WORKDIR /app

# same zależności z pyproject.toml (projekt nie jest paczką, kod przychodzi z backend/)
COPY backend/pyproject.toml .
RUN uv pip install --system -r pyproject.toml --extra dev

COPY --chmod=755 docker/dev/django/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY backend/ .

EXPOSE 8000

CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
