[project]
name = "{{ project_slug }}"
version = "0.1.0"
requires-python = ">={{ python_version }}"
dependencies = [
    "django>=6.1",
    "djangorestframework>=3.16",
    "django-environ>=0.11",
    "psycopg[binary]>=3.2",
{%- if use_celery %}
    "celery[redis]>=5.5",
    "django-redis>=5.4",
{%- endif %}
{%- if use_elasticsearch %}
    "elasticsearch>=8.15,<9",
{%- endif %}
]

[project.optional-dependencies]
dev = [
    "pytest>=8",
    "pytest-django>=4.9",
    "httpx>=0.28",
    "ruff>=0.8",
    "ipython>=9",
    "mypy>=2.3",
    "django-stubs[compatible-mypy]>=6.1",
    "djangorestframework-stubs[compatible-mypy]>=3.16",
]

[tool.pytest.ini_options]
DJANGO_SETTINGS_MODULE = "config.settings"
testpaths = ["tests/unit"]  # e2e osobno, make e2e
addopts = "--reuse-db"

[tool.ruff]
line-length = 120
exclude = ["migrations"]

[tool.ruff.lint]
select = ["E", "W", "F", "I", "N", "UP", "B", "C4", "SIM", "RUF", "ANN"]
ignore = ["E501"]  # długość linii pilnuje formatter

[tool.mypy]
strict = true
plugins = ["mypy_django_plugin.main"]
exclude = ["migrations/"]

[tool.django-stubs]
django_settings_module = "config.settings"

# bez typów w paczce i bez stubów
[[tool.mypy.overrides]]
module = ["environ"{% if use_celery %}, "celery"{% endif %}]
ignore_missing_imports = true
